# Modelo das variaveis de ambiente do projeto.
# Copie este arquivo para ".env" (que fica fora do git) e preencha a senha.

# Conexao com o PostgreSQL 17 local
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# Bancos do projeto (padrao: st_ = stage/transacional, dw_ = Data Warehouse)
ST_DB=st_anp
DW_DB=dw_anp
# Bancos gemeos usados pelo motor alternativo (comparacao Python x PDI)
ST_DB_PDI=st_anp_pdi
DW_DB_PDI=dw_anp_pdi

# Motor que grava nos bancos oficiais: python | pdi
MOTOR_PRINCIPAL=python

# Pentaho Data Integration
PENTAHO_HOME=C:\Pentaho\data-integration
