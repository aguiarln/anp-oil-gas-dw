    <name>SCD2 dim_campo</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <schema/>
    <table>dim_campo</table>
    <connection>dw_anp_pdi</connection>
    <commit>1000</commit>
    <update>Y</update>
    <fields>
      <key><name>nk_campo</name><lookup>nk_campo</lookup></key>
      <date><name/><from>etl_dt_inicio</from><to>etl_dt_fim</to></date>
      <field><name>nm_campo</name><lookup>nm_campo</lookup><update>Insert</update></field><field><name>nm_campo_atual</name><lookup>nm_campo_atual</lookup><update>Insert</update></field><field><name>nm_campo_sucessor</name><lookup>nm_campo_sucessor</lookup><update>Insert</update></field><field><name>nm_bacia</name><lookup>nm_bacia</lookup><update>Insert</update></field><field><name>nm_estado</name><lookup>nm_estado</lookup><update>Insert</update></field><field><name>sg_estado</name><lookup>sg_estado</lookup><update>Insert</update></field><field><name>nm_regiao</name><lookup>nm_regiao</lookup><update>Insert</update></field><field><name>desc_contorno_wkt</name><lookup>desc_contorno_wkt</lookup><update>Insert</update></field><field><name>nr_latitude_centro</name><lookup>nr_latitude_centro</lookup><update>Insert</update></field><field><name>nr_longitude_centro</name><lookup>nr_longitude_centro</lookup><update>Insert</update></field><field><name>dt_ultima_troca_operador</name><lookup>dt_ultima_troca_operador</lookup><update>Update</update></field><field><name>dt_ultima_venda</name><lookup>dt_ultima_venda</lookup><update>Update</update></field><field><name>dt_ultima_reorganizacao</name><lookup>dt_ultima_reorganizacao</lookup><update>Update</update></field>
      <return><name>sk_campo</name><rename/><creation_method>autoinc</creation_method><use_autoinc>Y</use_autoinc><version>etl_versao</version></return>
    </fields>
    <sequence/>
    <min_year>1900</min_year>
    <max_year>2199</max_year>
    <cache_size>5000</cache_size>
    <preload_cache>N</preload_cache>
    <use_start_date_alternative>N</use_start_date_alternative>
