  </step>
  <step>
    <name>De-para da dim_campo</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>SELECT 'dim_campo' AS nm_dimensao, c.id_campo AS id_stage, c.nome || ' (' || c.bacia || ')' AS nm_original,
       trab.chave(c.nome) || '|' || trab.chave(c.bacia) AS nk_dw
FROM trab.campo c WHERE c.id_campo IN (SELECT DISTINCT id_campo FROM trab.cons)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
