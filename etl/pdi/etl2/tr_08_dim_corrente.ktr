  <order>
    <hop><from>Regras da dim_corrente</from><to>Versões da dim_corrente</to><enabled>Y</enabled></hop>
    <hop><from>De-para da dim_corrente</from><to>etl_depara</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Regras da dim_corrente</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>-- T14 grafias; T19 uma versão por período de carga, só com a análise do óleo
WITH car AS (SELECT cp.*, trab.chave(cp.corrente) AS nk,
                    (grau_api IS NOT NULL)::int + (dest_leve_corte IS NOT NULL)::int + (dest_leve_pct IS NOT NULL)::int
                    + (dest_medio_corte IS NOT NULL)::int + (dest_medio_pct IS NOT NULL)::int
                    + (dest_pesado_corte IS NOT NULL)::int + (dest_pesado_pct IS NOT NULL)::int AS preenchidos
             FROM trab.caracterizacao cp WHERE cp.id_caracterizacao IN (SELECT DISTINCT id_caracterizacao FROM trab.cons)),
     nome AS (SELECT DISTINCT ON (nk) nk, corrente FROM (SELECT nk, corrente, count(*) AS n FROM car GROUP BY 1, 2) x
              ORDER BY nk, n DESC, corrente COLLATE "C"),
     analise AS (SELECT DISTINCT ON (nk, periodo_carga) * FROM car ORDER BY nk, periodo_carga, preenchidos DESC, id_caracterizacao),
     versoes AS (SELECT a.*, row_number() OVER (PARTITION BY a.nk ORDER BY a.periodo_carga) AS versao,
                        lead(a.periodo_carga) OVER (PARTITION BY a.nk ORDER BY a.periodo_carga) AS proximo
                 FROM analise a)
SELECT v.nk AS nk_corrente, n.corrente AS nm_corrente, v.periodo_carga AS dt_periodo_carga, v.grau_api AS nr_grau_api,
       v.dest_leve_corte AS nm_dest_leve_corte, v.dest_leve_pct AS nr_dest_leve_pct,
       v.dest_medio_corte AS nm_dest_medio_corte, v.dest_medio_pct AS nr_dest_medio_pct,
       v.dest_pesado_corte AS nm_dest_pesado_corte, v.dest_pesado_pct AS nr_dest_pesado_pct,
       CASE WHEN v.versao = 1 THEN TIMESTAMP '1900-01-01' ELSE v.periodo_carga::timestamp END AS etl_dt_inicio,
       coalesce(v.proximo::timestamp, TIMESTAMP '2199-12-31') AS etl_dt_fim, v.versao AS etl_versao
FROM versoes v JOIN nome n USING (nk)
ORDER BY 1, 3</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Versões da dim_corrente</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup><schema/><table>dim_corrente</table><key><name>nk_corrente</name><field>nk_corrente</field><condition>=</condition><name2/></key><key><name>dt_periodo_carga</name><field>dt_periodo_carga</field><condition>=</condition><name2/></key><value><name>nk_corrente</name><rename>nk_corrente</rename><update>N</update></value><value><name>dt_periodo_carga</name><rename>dt_periodo_carga</rename><update>N</update></value><value><name>nm_corrente</name><rename>nm_corrente</rename><update>Y</update></value><value><name>nm_dest_leve_corte</name><rename>nm_dest_leve_corte</rename><update>Y</update></value><value><name>nr_dest_leve_pct</name><rename>nr_dest_leve_pct</rename><update>Y</update></value><value><name>nm_dest_medio_corte</name><rename>nm_dest_medio_corte</rename><update>Y</update></value><value><name>nr_dest_medio_pct</name><rename>nr_dest_medio_pct</rename><update>Y</update></value><value><name>nm_dest_pesado_corte</name><rename>nm_dest_pesado_corte</rename><update>Y</update></value><value><name>nr_dest_pesado_pct</name><rename>nr_dest_pesado_pct</rename><update>Y</update></value><value><name>nr_grau_api</name><rename>nr_grau_api</rename><update>Y</update></value><value><name>etl_dt_inicio</name><rename>etl_dt_inicio</rename><update>Y</update></value><value><name>etl_dt_fim</name><rename>etl_dt_fim</rename><update>Y</update></value><value><name>etl_versao</name><rename>etl_versao</rename><update>Y</update></value></lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>De-para da dim_corrente</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>SELECT DISTINCT 'dim_corrente' AS nm_dimensao, cp.id_corrente AS id_stage, cp.corrente AS nm_original, trab.chave(cp.corrente) AS nk_dw
FROM trab.caracterizacao cp WHERE cp.id_caracterizacao IN (SELECT DISTINCT id_caracterizacao FROM trab.cons)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>etl_depara</name>
    <type>TableOutput</type>
