<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_08_dim_corrente</name>
    <description>Corrente de petróleo (T14) com a análise do óleo; cada período de carga é uma versão (T19).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters></parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>100000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies></dependencies>
    <partitionschemas></partitionschemas>
    <slaveservers></slaveservers>
    <clusterschemas></clusterschemas>
    <created_user>anp-oil-gas-dw</created_user>
    <created_date>2026/11/14 12:00:00.000</created_date>
    <modified_user>anp-oil-gas-dw</modified_user>
    <modified_date>2026/11/14 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>dim_corrente: cada período de carga da análise do óleo é uma versão (T19); a versão vale do seu período
até o período seguinte. Insert/Update pela chave natural + período de carga.</note>
      <xloc>20</xloc><yloc>4</yloc><width>640</width><heigth>50</heigth>
      <fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred><fontcolorgreen>58</fontcolorgreen><fontcolorblue>105</fontcolorblue>
      <backgroundcolorred>230</backgroundcolorred><backgroundcolorgreen>240</backgroundcolorgreen><backgroundcolorblue>250</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>st_anp</name>
