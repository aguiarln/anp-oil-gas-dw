  <order>
    <hop><from>Regras da dim_poco</from><to>SCD2 dim_poco</to><enabled>Y</enabled></hop>
    <hop><from>De-para da dim_poco</from><to>etl_depara</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Regras da dim_poco</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>-- T13a estado pelo sufixo do nome do poço; T13b estado conhecido; T16 ambiente Pré-sal; coordenada mais recente
WITH estados AS (  -- cadastro da stage (o mais recente de cada sigla) completado pela tabela do IBGE
         SELECT DISTINCT ON (sigla) sigla, nome, regiao FROM trab.estado WHERE sigla IS NOT NULL ORDER BY sigla, id_estado DESC),
     siglas AS (SELECT sigla, nome, regiao FROM estados
                UNION ALL
                SELECT i.sigla, initcap(i.nome), i.regiao FROM trab.ibge i WHERE i.sigla NOT IN (SELECT sigla FROM estados)),
     info AS (SELECT c.id_poco, p.nome_anp,
                     mode() WITHIN GROUP (ORDER BY c.arquivo_origem) AS origem,
                     mode() WITHIN GROUP (ORDER BY c.id_estado) AS id_estado,
                     min(c.periodo) FILTER (WHERE coalesce(c.petroleo_bbl_dia, 0) + coalesce(c.gas_total_mm3_dia, 0) &gt; 0) AS primeira,
                     max(c.periodo) FILTER (WHERE coalesce(c.petroleo_bbl_dia, 0) + coalesce(c.gas_total_mm3_dia, 0) &gt; 0) AS ultima
              FROM trab.cons c JOIN trab.poco p USING (id_poco) GROUP BY 1, 2),
     sufixo AS (SELECT i.*, upper(regexp_replace(i.nome_anp, '^.*-', '')) AS suf FROM info i),
     uf AS (SELECT s.*,
                   coalesce(CASE WHEN s.suf IN (SELECT sigla FROM siglas) THEN s.suf
                                 WHEN length(s.suf) = 3 AND right(s.suf, 1) = 'S' AND left(s.suf, 2) IN (SELECT sigla FROM siglas)
                                 THEN left(s.suf, 2) END,
                            e.sigla) AS sigla
            FROM sufixo s LEFT JOIN trab.estado e ON e.id_estado = s.id_estado)
SELECT u.nome_anp AS nk_poco, u.nome_anp AS nm_poco, coalesce(sg.nome, 'N/A') AS nm_estado, coalesce(u.sigla, 'NA') AS sg_estado,
       coalesce(sg.regiao, 'N/A') AS nm_regiao,
       CASE WHEN u.id_poco IN (SELECT id_poco FROM trab.pocos_presal) THEN 'Pré-sal'
            WHEN u.origem = 'terra' THEN 'Terra' ELSE 'Mar' END AS nm_ambiente,
       trab.ponto_lat(cp.geometria_wkt) AS nr_latitude, trab.ponto_lon(cp.geometria_wkt) AS nr_longitude,
       u.primeira AS dt_primeira_producao, u.ultima AS dt_ultima_producao
FROM uf u LEFT JOIN siglas sg ON sg.sigla = u.sigla LEFT JOIN trab.coordenada_poco cp ON cp.id_poco = u.id_poco
ORDER BY 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>SCD2 dim_poco</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <schema/>
    <table>dim_poco</table>
    <connection>dw_anp_pdi</connection>
    <commit>1000</commit>
    <update>Y</update>
    <fields>
      <key><name>nk_poco</name><lookup>nk_poco</lookup></key>
      <date><name/><from>etl_dt_inicio</from><to>etl_dt_fim</to></date>
      <field><name>nm_poco</name><lookup>nm_poco</lookup><update>Insert</update></field><field><name>nm_estado</name><lookup>nm_estado</lookup><update>Insert</update></field><field><name>sg_estado</name><lookup>sg_estado</lookup><update>Insert</update></field><field><name>nm_regiao</name><lookup>nm_regiao</lookup><update>Insert</update></field><field><name>nm_ambiente</name><lookup>nm_ambiente</lookup><update>Insert</update></field><field><name>nr_latitude</name><lookup>nr_latitude</lookup><update>Insert</update></field><field><name>nr_longitude</name><lookup>nr_longitude</lookup><update>Insert</update></field><field><name>dt_primeira_producao</name><lookup>dt_primeira_producao</lookup><update>Update</update></field><field><name>dt_ultima_producao</name><lookup>dt_ultima_producao</lookup><update>Update</update></field>
      <return><name>sk_poco</name><rename/><creation_method>autoinc</creation_method><use_autoinc>Y</use_autoinc><version>etl_versao</version></return>
    </fields>
    <sequence/>
    <min_year>1900</min_year>
    <max_year>2199</max_year>
    <cache_size>5000</cache_size>
    <preload_cache>N</preload_cache>
    <use_start_date_alternative>N</use_start_date_alternative>
    <start_date_alternative>none</start_date_alternative>
    <start_date_field_name/>
    <useBatch>N</useBatch>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>De-para da dim_poco</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>SELECT 'dim_poco' AS nm_dimensao, p.id_poco AS id_stage, p.nome_anp AS nm_original, p.nome_anp AS nk_dw
FROM trab.poco p WHERE p.id_poco IN (SELECT DISTINCT id_poco FROM trab.cons)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>etl_depara</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <schema></schema>
    <table>etl_depara</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>nm_dimensao</column_name><stream_name>nm_dimensao</stream_name></field><field><column_name>id_stage</column_name><stream_name>id_stage</stream_name></field><field><column_name>nm_original</column_name><stream_name>nm_original</stream_name></field><field><column_name>nk_dw</column_name><stream_name>nk_dw</stream_name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling></step_error_handling>
  <slave-step-copy-partition-distribution></slave-step-copy-partition-distribution>
