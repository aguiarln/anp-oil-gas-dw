    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>nm_dimensao</column_name><stream_name>nm_dimensao</stream_name></field><field><column_name>id_stage</column_name><stream_name>id_stage</stream_name></field><field><column_name>nm_original</column_name><stream_name>nm_original</stream_name></field><field><column_name>nk_dw</column_name><stream_name>nk_dw</stream_name></field></fields>
    <attributes/>
