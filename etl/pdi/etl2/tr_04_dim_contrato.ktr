  </info>
  <notepads>
    <notepad>
      <note>dim_contrato: Contrato com os dígitos e a letra final (T15). SCD2: todos os atributos.
De-para (T22): de qual linha da stage veio cada chave natural.</note>
      <xloc>20</xloc><yloc>4</yloc><width>640</width><heigth>60</heigth>
      <fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred><fontcolorgreen>58</fontcolorgreen><fontcolorblue>105</fontcolorblue>
      <backgroundcolorred>230</backgroundcolorred><backgroundcolorgreen>240</backgroundcolorgreen><backgroundcolorblue>250</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>st_anp</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>st_anp</database>
    <port>5432</port>
    <username>postgres</username>
    <password>${PG_SENHA}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5432</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes>
  </connection>
  <connection>
    <name>dw_anp_pdi</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_anp_pdi</database>
    <port>5432</port>
    <username>postgres</username>
    <password>${PG_SENHA}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5432</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes>
  </connection>
  <order>
    <hop><from>Regras da dim_contrato</from><to>SCD2 dim_contrato</to><enabled>Y</enabled></hop>
    <hop><from>De-para da dim_contrato</from><to>etl_depara</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Regras da dim_contrato</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>-- T15 contrato com os dígitos e a letra final; os dados vêm primeiro da relação de concessionários (com rodada)
WITH m AS (SELECT c.*, trab.chave_contrato(c.numero) AS nk FROM trab.contrato c WHERE trab.chave_contrato(c.numero) IS NOT NULL)
SELECT nk AS nk_contrato, nk AS nr_contrato,
       coalesce((array_agg(nome ORDER BY rodada IS NULL, id_contrato) FILTER (WHERE nome &lt;&gt; ''))[1], 'N/A') AS nm_contrato,
       coalesce((array_agg(rodada ORDER BY rodada IS NULL, id_contrato) FILTER (WHERE rodada &lt;&gt; ''))[1], 'N/A') AS nm_rodada,
       coalesce((array_agg(fase ORDER BY rodada IS NULL, id_contrato) FILTER (WHERE fase &lt;&gt; ''))[1], 'N/A') AS nm_fase,
       coalesce((array_agg(ambiente ORDER BY rodada IS NULL, id_contrato) FILTER (WHERE ambiente &lt;&gt; ''))[1], 'N/A') AS nm_ambiente,
       coalesce((array_agg(bacia ORDER BY rodada IS NULL, id_contrato) FILTER (WHERE bacia &lt;&gt; ''))[1], 'N/A') AS nm_bacia
FROM m GROUP BY nk ORDER BY nk</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>SCD2 dim_contrato</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <schema/>
    <table>dim_contrato</table>
    <connection>dw_anp_pdi</connection>
    <commit>1000</commit>
    <update>Y</update>
    <fields>
      <key><name>nk_contrato</name><lookup>nk_contrato</lookup></key>
      <date><name/><from>etl_dt_inicio</from><to>etl_dt_fim</to></date>
      <field><name>nr_contrato</name><lookup>nr_contrato</lookup><update>Insert</update></field><field><name>nm_contrato</name><lookup>nm_contrato</lookup><update>Insert</update></field><field><name>nm_rodada</name><lookup>nm_rodada</lookup><update>Insert</update></field><field><name>nm_fase</name><lookup>nm_fase</lookup><update>Insert</update></field><field><name>nm_ambiente</name><lookup>nm_ambiente</lookup><update>Insert</update></field><field><name>nm_bacia</name><lookup>nm_bacia</lookup><update>Insert</update></field>
      <return><name>sk_contrato</name><rename/><creation_method>autoinc</creation_method><use_autoinc>Y</use_autoinc><version>etl_versao</version></return>
    </fields>
    <sequence/>
    <min_year>1900</min_year>
    <max_year>2199</max_year>
    <cache_size>5000</cache_size>
    <preload_cache>N</preload_cache>
    <use_start_date_alternative>N</use_start_date_alternative>
    <start_date_alternative>none</start_date_alternative>
    <start_date_field_name/>
    <useBatch>N</useBatch>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>De-para da dim_contrato</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>SELECT 'dim_contrato' AS nm_dimensao, id_contrato AS id_stage, numero AS nm_original, trab.chave_contrato(numero) AS nk_dw
FROM trab.contrato WHERE trab.chave_contrato(numero) IS NOT NULL</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>etl_depara</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <schema></schema>
    <table>etl_depara</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>nm_dimensao</column_name><stream_name>nm_dimensao</stream_name></field><field><column_name>id_stage</column_name><stream_name>id_stage</stream_name></field><field><column_name>nm_original</column_name><stream_name>nm_original</stream_name></field><field><column_name>nk_dw</column_name><stream_name>nk_dw</stream_name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling></step_error_handling>
  <slave-step-copy-partition-distribution></slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
</transformation>
