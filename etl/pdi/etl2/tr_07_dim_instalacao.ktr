    <database>st_anp</database>
    <port>5432</port>
    <username>postgres</username>
    <password>${PG_SENHA}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5432</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes>
  </connection>
  <connection>
    <name>dw_anp_pdi</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_anp_pdi</database>
    <port>5432</port>
    <username>postgres</username>
    <password>${PG_SENHA}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>5432</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes>
  </connection>
  <order>
    <hop><from>Regras da dim_instalacao</from><to>SCD2 dim_instalacao</to><enabled>Y</enabled></hop>
    <hop><from>De-para da dim_instalacao</from><to>etl_depara</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Regras da dim_instalacao</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>-- T14 grafias; T13c tipo de instalação mais recente
WITH i AS (SELECT i.id_instalacao, i.nome, count(*) AS n,
                  (array_agg(c.tipo_instalacao ORDER BY c.periodo DESC) FILTER (WHERE c.tipo_instalacao IS NOT NULL))[1] AS tipo
           FROM trab.cons c JOIN trab.instalacao i USING (id_instalacao) GROUP BY 1, 2)
SELECT trab.chave(nome) AS nk_instalacao,
       (array_agg(nome ORDER BY n DESC, nome COLLATE "C"))[1] AS nm_instalacao,
       coalesce((array_agg(tipo ORDER BY n DESC, id_instalacao) FILTER (WHERE tipo &lt;&gt; ''))[1], 'N/A') AS nm_tipo_instalacao
FROM i GROUP BY trab.chave(nome) ORDER BY 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>SCD2 dim_instalacao</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <schema/>
    <table>dim_instalacao</table>
    <connection>dw_anp_pdi</connection>
    <commit>1000</commit>
    <update>Y</update>
    <fields>
      <key><name>nk_instalacao</name><lookup>nk_instalacao</lookup></key>
      <date><name/><from>etl_dt_inicio</from><to>etl_dt_fim</to></date>
      <field><name>nm_instalacao</name><lookup>nm_instalacao</lookup><update>Insert</update></field><field><name>nm_tipo_instalacao</name><lookup>nm_tipo_instalacao</lookup><update>Insert</update></field>
      <return><name>sk_instalacao</name><rename/><creation_method>autoinc</creation_method><use_autoinc>Y</use_autoinc><version>etl_versao</version></return>
    </fields>
    <sequence/>
    <min_year>1900</min_year>
    <max_year>2199</max_year>
    <cache_size>5000</cache_size>
    <preload_cache>N</preload_cache>
    <use_start_date_alternative>N</use_start_date_alternative>
    <start_date_alternative>none</start_date_alternative>
    <start_date_field_name/>
    <useBatch>N</useBatch>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>De-para da dim_instalacao</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>SELECT 'dim_instalacao' AS nm_dimensao, i.id_instalacao AS id_stage, i.nome AS nm_original, trab.chave(i.nome) AS nk_dw
FROM trab.instalacao i WHERE i.id_instalacao IN (SELECT DISTINCT id_instalacao FROM trab.cons)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>etl_depara</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <schema></schema>
    <table>etl_depara</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>nm_dimensao</column_name><stream_name>nm_dimensao</stream_name></field><field><column_name>id_stage</column_name><stream_name>id_stage</stream_name></field><field><column_name>nm_original</column_name><stream_name>nm_original</stream_name></field><field><column_name>nk_dw</column_name><stream_name>nk_dw</stream_name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling></step_error_handling>
  <slave-step-copy-partition-distribution></slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
</transformation>
