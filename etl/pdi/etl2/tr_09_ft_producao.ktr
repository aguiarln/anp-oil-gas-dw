  <step>
    <name>Produção com chaves e preço</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>-- Grão poço x campo x mês (trab.cons). T10 volume do mês = média diária x dias do mês;
-- T11/T18 preço do petróleo por contrato + campo + mês (média dos preços publicados) ou, se um só
-- contrato publica para o campo no mês, pelo campo; receita = petróleo (m3) x preço.
-- Chaves substitutas: versão vigente de cada dimensão, pela chave natural do etl_depara; 0 = não se aplica.
WITH preco AS (SELECT coalesce(trab.chave_contrato(numero), '-') AS kc, coalesce(trab.chave(campo_nome), '-') AS kf, periodo, valor_rs_m3
               FROM trab.preco),
     preco_contrato AS (SELECT kc, kf, periodo, avg(valor_rs_m3) AS preco FROM preco GROUP BY 1, 2, 3),
     preco_campo AS (SELECT kf, periodo, avg(valor_rs_m3) AS preco FROM preco GROUP BY 1, 2 HAVING count(DISTINCT kc) = 1),
     campo AS (SELECT c.id_campo, coalesce(trab.chave(c.nome), '-') AS kf, d.sk_campo
               FROM trab.campo c
               JOIN etl_depara m ON m.nm_dimensao = 'dim_campo' AND m.id_stage = c.id_campo
               JOIN dim_campo d ON d.nk_campo = m.nk_dw AND d.sk_campo &lt;&gt; 0 AND d.etl_dt_fim &gt;= '2199-12-31'),
     contrato AS (SELECT c.id_contrato, coalesce(trab.chave_contrato(c.numero), '-') AS kc, coalesce(d.sk_contrato, 0) AS sk_contrato
                  FROM trab.contrato c
                  LEFT JOIN etl_depara m ON m.nm_dimensao = 'dim_contrato' AND m.id_stage = c.id_contrato
                  LEFT JOIN dim_contrato d ON d.nk_contrato = m.nk_dw AND d.sk_contrato &lt;&gt; 0 AND d.etl_dt_fim &gt;= '2199-12-31'),
     poco AS (SELECT m.id_stage AS id_poco, d.sk_poco FROM etl_depara m
              JOIN dim_poco d ON d.nk_poco = m.nk_dw AND d.sk_poco &lt;&gt; 0 AND d.etl_dt_fim &gt;= '2199-12-31'
              WHERE m.nm_dimensao = 'dim_poco'),
     empresa AS (SELECT m.id_stage AS id_empresa, d.sk_empresa FROM etl_depara m
                 JOIN dim_empresa d ON d.nk_empresa = m.nk_dw AND d.sk_empresa &lt;&gt; 0 AND d.etl_dt_fim &gt;= '2199-12-31'
                 WHERE m.nm_dimensao = 'dim_empresa'),
     instalacao AS (SELECT m.id_stage AS id_instalacao, d.sk_instalacao FROM etl_depara m
                    JOIN dim_instalacao d ON d.nk_instalacao = m.nk_dw AND d.sk_instalacao &lt;&gt; 0 AND d.etl_dt_fim &gt;= '2199-12-31'
                    WHERE m.nm_dimensao = 'dim_instalacao'),
     corrente AS (SELECT c.id_caracterizacao, d.sk_corrente FROM trab.caracterizacao c
                  JOIN dim_corrente d ON d.sk_corrente &lt;&gt; 0 AND d.nk_corrente = trab.chave(c.corrente) AND d.dt_periodo_carga = c.periodo_carga)
SELECT to_char(f.periodo, 'YYYYMM01')::int AS sk_data,
       po.sk_poco, ca.sk_campo,
       coalesce(em.sk_empresa, 0) AS sk_empresa, coalesce(ct.sk_contrato, 0) AS sk_contrato,
       coalesce(it.sk_instalacao, 0) AS sk_instalacao, coalesce(cr.sk_corrente, 0) AS sk_corrente,
       coalesce(f.oleo_bbl_dia, 0) * dias.n AS md_oleo_bbl,
       coalesce(f.condensado_bbl_dia, 0) * dias.n AS md_condensado_bbl,
       coalesce(f.petroleo_bbl_dia, 0) * dias.n AS md_petroleo_bbl,
       coalesce(f.agua_bbl_dia, 0) * dias.n AS md_agua_bbl,
       coalesce(f.gas_assoc_mm3_dia, 0) * dias.n AS md_gas_assoc_mil_m3,
       coalesce(f.gas_nao_assoc_mm3_dia, 0) * dias.n AS md_gas_nao_assoc_mil_m3,
       coalesce(f.gas_total_mm3_dia, 0) * dias.n AS md_gas_total_mil_m3,
       f.horas_producao AS md_horas_producao,
       coalesce(pc.preco, pf.preco) AS md_preco_rs_m3,
       coalesce(f.petroleo_bbl_dia, 0) * dias.n * 0.158987294928 * coalesce(pc.preco, pf.preco) AS md_receita_estimada_rs
FROM trab.cons f
CROSS JOIN LATERAL (SELECT extract(day FROM date_trunc('month', f.periodo) + interval '1 month - 1 day')::int AS n) dias
JOIN poco po USING (id_poco)
JOIN campo ca USING (id_campo)
JOIN contrato ct USING (id_contrato)
LEFT JOIN empresa em USING (id_empresa)
LEFT JOIN instalacao it USING (id_instalacao)
LEFT JOIN corrente cr USING (id_caracterizacao)
LEFT JOIN preco_contrato pc ON pc.kc = ct.kc AND pc.kf = ca.kf AND pc.periodo = f.periodo
LEFT JOIN preco_campo pf ON pf.kf = ca.kf AND pf.periodo = f.periodo</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
