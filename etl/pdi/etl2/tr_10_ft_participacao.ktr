  <step>
    <name>Participações por foto</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_anp_pdi</connection>
    <sql>-- Uma linha por sócia, contrato e foto da relação de concessionários (a data do download é a data da foto);
-- grafias unidas (T07) no mesmo contrato somam a participação
WITH p AS (SELECT p.*, (regexp_match(p.nome_arquivo, '/([0-9]{4})-([0-9]{2})-([0-9]{2})/')) AS d FROM trab.participacao p)
SELECT (p.d[1] || p.d[2] || p.d[3])::int AS sk_data,
       coalesce(em.sk_empresa, 0) AS sk_empresa, coalesce(co.sk_contrato, 0) AS sk_contrato,
       sum(p.percentual) AS md_percentual, CASE WHEN bool_or(p.operador) THEN 'S' ELSE 'N' END AS dd_operador
FROM p
LEFT JOIN etl_depara me ON me.nm_dimensao = 'dim_empresa' AND me.id_stage = p.id_empresa
LEFT JOIN dim_empresa em ON em.sk_empresa &lt;&gt; 0 AND em.etl_dt_fim &gt;= '2199-12-31' AND em.nk_empresa = me.nk_dw
LEFT JOIN etl_depara mt ON mt.nm_dimensao = 'dim_contrato' AND mt.id_stage = p.id_contrato
LEFT JOIN dim_contrato co ON co.sk_contrato &lt;&gt; 0 AND co.etl_dt_fim &gt;= '2199-12-31' AND co.nk_contrato = mt.nk_dw
GROUP BY 1, 2, 3</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>140</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
