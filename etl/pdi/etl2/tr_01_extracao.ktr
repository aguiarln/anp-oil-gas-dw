    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>368</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Stage: Caracterização do petróleo</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>st_anp</connection>
    <sql>-- Só a análise do óleo (T19)
SELECT cp.id_caracterizacao, co.id_corrente, co.nome AS corrente, cp.periodo_carga, cp.grau_api,
       cp.dest_leve_corte, cp.dest_leve_pct, cp.dest_medio_corte, cp.dest_medio_pct, cp.dest_pesado_corte, cp.dest_pesado_pct
FROM caracterizacao_petroleo cp JOIN corrente co USING (id_corrente)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>624</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Stage: Contornos dos campos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>st_anp</connection>
    <sql>-- Contorno mais recente de cada campo, com o nome e a bacia como a camada escreve (T20)
SELECT c.id_campo, c.nome, b.nome AS bacia, cc.geometria_wkt
FROM coordenada_campo cc JOIN campo c USING (id_campo) JOIN bacia b USING (id_bacia)
WHERE cc.id_carga = (SELECT max(id_carga) FROM coordenada_campo x WHERE x.id_campo = cc.id_campo)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>752</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Stage: Contratos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>st_anp</connection>
    <sql>SELECT c.id_contrato, c.numero, c.nome, c.rodada, c.fase, c.ambiente, b.nome AS bacia
FROM contrato c LEFT JOIN bacia b USING (id_bacia)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>304</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Stage: Coordenadas dos poços</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
