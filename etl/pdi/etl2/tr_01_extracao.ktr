  <step>
    <name>Stage: Preços do petróleo</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>st_anp</connection>
    <sql>-- Preço do petróleo: versão mais recente de cada preço publicado (T17), sem os vazios (T11, T18)
SELECT c.numero, p.campo_nome, p.periodo, p.valor_rs_m3
FROM (SELECT pp.*, max(id_carga) OVER (PARTITION BY id_contrato, campo_nome, id_corrente, periodo, tipo_preco) AS ultima
      FROM preco_petroleo pp) p
JOIN contrato c USING (id_contrato)
WHERE p.id_carga = p.ultima AND p.valor_rs_m3 IS NOT NULL</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>880</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Stage: Produção (T17, T16, T02)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>st_anp</connection>
    <sql>-- Produção no grão da fato (poço x campo x mês):
-- T17 versão mais recente de cada linha; T16 sem o pré-sal que repete o mar; T02 repetições pelo maior valor
WITH ult AS (
    SELECT * FROM (SELECT pm.*, max(id_carga) OVER (PARTITION BY id_poco, id_campo, periodo, arquivo_origem) AS ultima
                   FROM producao_mensal pm) x
    WHERE id_carga = ultima
)
SELECT id_poco, id_campo, periodo,
       max(arquivo_origem) AS arquivo_origem, max(id_estado) AS id_estado, max(id_empresa) AS id_empresa,
       max(id_contrato) AS id_contrato, max(id_caracterizacao) AS id_caracterizacao,
       (array_agg(id_instalacao ORDER BY id_instalacao IS NULL, horas_producao DESC NULLS LAST))[1] AS id_instalacao,
       (array_agg(tipo_instalacao ORDER BY tipo_instalacao IS NULL, horas_producao DESC NULLS LAST))[1] AS tipo_instalacao,
       count(*) AS linhas_consolidadas,
       max(oleo_bbl_dia) AS oleo_bbl_dia, max(condensado_bbl_dia) AS condensado_bbl_dia,
       max(petroleo_bbl_dia) AS petroleo_bbl_dia, max(gas_assoc_mm3_dia) AS gas_assoc_mm3_dia,
       max(gas_nao_assoc_mm3_dia) AS gas_nao_assoc_mm3_dia, max(gas_total_mm3_dia) AS gas_total_mm3_dia,
       max(agua_bbl_dia) AS agua_bbl_dia, max(horas_producao) AS horas_producao
FROM ult u
WHERE NOT (arquivo_origem = 'presal' AND EXISTS (
           SELECT 1 FROM ult m WHERE m.arquivo_origem = 'mar'
           AND (m.id_poco, m.id_campo, m.periodo) = (u.id_poco, u.id_campo, u.periodo)))
GROUP BY id_poco, id_campo, periodo</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>112</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
